const mongoose = require('mongoose');

const taskSchema = new mongoose.Schema({
  title: {
    type: String,
    required: true,
  },
  description: {
    type: String,
    required: true,
  },
  deadline: {
    type: Date,
    required: true,
  },
  status: {
    type: String,
    default: 'Pending', // e.g., Pending, In Progress, Completed
  },
  assignedTo: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'User', // This will reference the User model
  },
  createdAt: {
    type: Date,
    default: Date.now,
  },
});

module.exports = mongoose.model('Task', taskSchema);
